# Dockerfile.airflow (FIXED)

FROM apache/airflow:2.9.2-python3.11

USER root

# Install system dependencies
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        gcc \
        g++ \
        libpq-dev \
        curl \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

USER airflow

# Upgrade pip
RUN pip install --upgrade pip

# Install Python packages (FIXED - use quotes for version constraints)
RUN pip install \
    'sqlalchemy>=1.4,<2.0' \
    psycopg2-binary==2.9.9 \
    pandas==2.1.4 \
    numpy==1.26.2 \
    scikit-learn==1.3.2 \
    xgboost==2.0.3 \
    lightgbm==4.1.0 \
    boto3==1.34.14 \
    mlflow==2.9.2 \
    requests==2.31.0